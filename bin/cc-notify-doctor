#!/usr/bin/env bash
# cc-notify-doctor — diagnose "no notifications" + benchmark the capture calls.
# Usage: bin/cc-notify-doctor   (run from anywhere; it fires one real test banner)

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ms() {
  # Time a command N times, print min/median/max in ms. Uses bash TIMEFORMAT.
  local label="$1"; shift
  local n=5 i t times=() ; local TIMEFORMAT='%R'
  for ((i=0;i<n;i++)); do
    t=$({ time "$@" >/dev/null 2>&1; } 2>&1)
    times+=("$t")
  done
  printf '%s\n' "${times[@]}" | sort -n | awk -v l="$label" '
    {a[NR]=$1}
    END{ printf "  %-42s min %5.0fms  med %5.0fms  max %5.0fms\n",
         l, a[1]*1000, a[int((NR+1)/2)]*1000, a[NR]*1000 }'
}

bold "== 1. Gates (any of these silences notifications) =="
for f in notify.disable_stop notify.suppress_when_focused; do
  if [ -f "$HOME/.claude/$f" ]; then echo "  ⚠️  ~/.claude/$f EXISTS"; else echo "  ok  ~/.claude/$f absent"; fi
done

bold "== 2. macOS Focus / Do Not Disturb =="
dnd=$(defaults -currentHost read ~/Library/Preferences/ByHost/com.apple.notificationcenterui doNotDisturb 2>/dev/null)
echo "  doNotDisturb(legacy)=${dnd:-unknown}  (alerter passes --ignore-dnd, but Focus modes can still gate)"

bold "== 3. Live plugin scripts present + valid =="
for d in "$HOME/.claude/plugins/cache/farishijazi-plugins/cc-notify"/*/ \
         "$HOME/.claude/plugins/marketplaces/farishijazi-plugins/plugins/cc-notify/"; do
  [ -d "$d" ] || continue
  s="$d/hooks/cc-notify.sh"
  if [ -f "$s" ]; then bash -n "$s" 2>/dev/null && echo "  ok  $s" || echo "  ✗ SYNTAX ERROR $s"; fi
done

bold "== 4. alerter present + how many live now =="
echo "  bin: $(command -v alerter || echo MISSING)"
echo "  live alerter procs: $(pgrep -c -f '[a]lerter' 2>/dev/null || echo 0)"

bold "== 5. Capture-call timings (the latency hypothesis) =="
ms "ps -axo pid,ppid,comm (full table)"  ps -axo pid,ppid,comm
command -v tmux >/dev/null && ms "tmux list-clients" tmux list-clients
if command -v aerospace >/dev/null; then
  ms "aerospace list-windows --focused"     aerospace list-windows --focused --format '%{window-id}'
  ms "aerospace list-windows --monitor all" aerospace list-windows --monitor all --format '%{window-id}'
fi
echo "  node -e 0 (interp startup, x per hook):"
ms "node -e 0" node -e 0

bold "== 6. End-to-end: fire ONE real banner via the live plugin =="
plugin=$(ls -d "$HOME/.claude/plugins/cache/farishijazi-plugins/cc-notify"/*/ 2>/dev/null | tail -1)
plugin="${plugin%/}"
if [ -n "$plugin" ]; then
  echo '{"session_id":"doctor","cwd":"'"$PWD"'","message":"doctor test — do you see this banner?"}' \
    | CLAUDE_PLUGIN_ROOT="$plugin" bash "$plugin/hooks/cc-notify.sh" notification
  echo "  fired (exit $?). A banner should appear within ~1s. Route:"
  sleep 0.4
  [ -f /tmp/cc-notify/doctor.route ] && echo "  ✓ route written" || echo "  ✗ NO route — hook bailed early"
  echo "  → If no banner appears but route is written, the issue is macOS NotificationCenter (Focus/throttle), not cc-notify."
else
  echo "  ✗ no plugin cache dir found"
fi

bold "== 7. Remote sessions (bridge) =="
if [ -f "$HOME/.claude/notify.disable_remote" ]; then
  echo "  ✗ DISABLED by ~/.claude/notify.disable_remote"
else
  here_bin="$(cd "$(dirname "$0")" && pwd)"
  echo "  supervisor: $(launchctl list 2>/dev/null | awk '/cc-notify-remote/{print "loaded pid="$1} END{if(!NR) print "NOT installed (run bin/cc-install-remote-agent)"}')"
  echo "  hosts:      $("$here_bin/cc-remote-bridge" --hosts 2>/dev/null | tr '\n' ' ')"
  for f in /tmp/cc-notify/bridge-*.pid; do
    [ -f "$f" ] || continue
    h=$(basename "$f" .pid); h=${h#bridge-}
    [ "$h" = supervisor ] && continue
    p=$(cat "$f" 2>/dev/null)
    kill -0 "$p" 2>/dev/null && echo "  streamer $h: alive (pid $p)" || echo "  streamer $h: DEAD (stale pidfile)"
  done
  echo "  hub panes (a remote session can only be clicked to if it is tiled into one):"
  tmux list-panes -a -F '    #{pane_id} #{@tw-src} @cc-status=#{@cc-status}' 2>/dev/null \
    | awk 'NF>2' | sed 's/\t/:/' | head -20
  echo "  log: /tmp/cc-notify/remote-bridge.log"
fi

bold "== 8. Editor integration (VS Code / Cursor) =="
ext_src="$(cd "$(dirname "$0")/../editor-extension" 2>/dev/null && pwd)"
if [ -z "$ext_src" ] || [ ! -f "$ext_src/package.json" ]; then
  echo "  ✗ editor-extension/ not found next to this script"
else
  want_ver="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ext_src/package.json" | head -1)"
  echo "  manifest version: ${want_ver:-?}"
  # extensionKind MUST be ui: with a `main` and no extensionKind, VS Code deduces
  # ['workspace'] and a Remote-SSH window runs it on the REMOTE box — where it is
  # typically not installed, so there is no handler at all. See LESSONS.
  grep -q '"ui"' "$ext_src/package.json" \
    && echo "  extensionKind:    ui (correct — runs locally even in a Remote-SSH window)" \
    || echo "  ✗ extensionKind not \"ui\" — a Remote-SSH window will have NO handler"
  found=0
  for d in "$HOME/.vscode/extensions" "$HOME/.cursor/extensions"; do
    [ -d "$d" ] || continue
    for link in "$d"/farishijazi.cc-notify-focus-*; do
      [ -e "$link" ] || continue
      found=1
      have_ver="${link##*cc-notify-focus-}"
      if [ "$have_ver" = "$want_ver" ]; then
        echo "  ✔ $(basename "$d")/$(basename "$link")"
      else
        # The folder name MUST equal <publisher>.<name>-<version> or the editor
        # calls the unpacked extension invalid and tries to reinstall it from the
        # marketplace by id — the v1.7.10 "cannot be installed" toast.
        echo "  ✗ $(basename "$d")/$(basename "$link") is v$have_ver but manifest is v$want_ver → re-run bin/cc-install-editor-extension"
      fi
    done
  done
  [ "$found" = 1 ] || echo "  ✗ not installed in either editor (run bin/cc-install-editor-extension)"
  # Liveness. The breadcrumb APPENDS, so the last line is the last real action;
  # 'watcher started' alone means it loaded but has never been asked to focus.
  if [ -s /tmp/cc-notify/focus.log ]; then
    echo "  focus.log ($(wc -l </tmp/cc-notify/focus.log | tr -d ' ') lines), last:"
    echo "    $(tail -1 /tmp/cc-notify/focus.log)"
  else
    echo "  ✗ /tmp/cc-notify/focus.log empty — extension never activated (reload the editor window)"
  fi
fi
